{
  "name": "firescope",
  "version": "0.1.1",
  "description": "A convention-first framework for Firebase apps, functions, hosting, environments, and deploys.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maskjelly/firescope.git"
  },
  "bugs": {
    "url": "https://github.com/maskjelly/firescope/issues"
  },
  "homepage": "https://maskjelly.github.io/firescope/",
  "bin": {
    "firescope": "dist/cli/index.js",
    "create-firescope": "dist/create/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js"
    },
    "./firestore": {
      "types": "./dist/firestore.d.ts",
      "import": "./dist/firestore.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
